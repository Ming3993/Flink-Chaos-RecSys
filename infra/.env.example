# IP LAN của máy chạy Redpanda & Redis (nếu test tất cả trên 1 máy thì để localhost hoặc 127.0.0.1,
# nếu chạy trên PVE LXC thì điền IP LAN của LXC đó, ví dụ: 192.168.1.50)
HOST_IP=127.0.0.1

# Địa chỉ Redpanda & Redis mà Flink Job sẽ kết nối tới
# - Nếu Flink chạy cùng Docker Compose với Redpanda/Redis: dùng "redpanda:29092" và "redis"
# - Nếu tách Flink xuống Mac còn Redpanda/Redis trên Dell: đổi thành "<IP_DELL>:9092" và "<IP_DELL>"
KAFKA_BOOTSTRAP_SERVERS=redpanda:29092
REDIS_HOST=redis
REDIS_PORT=6379

# Số lượng Task Slots cho mỗi TaskManager (với 4 vCPU trên Dell nên để 2 hoặc 4)
FLINK_TASK_SLOTS=2
